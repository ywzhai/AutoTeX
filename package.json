{
  "name": "autotex",
  "version": "1.2.0",
  "private": true,
  "description": "Local math completions for Overleaf's LaTeX source editor",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser.test.cjs",
    "package": "node scripts/package.cjs",
    "model:prepare": "node scripts/train-model.cjs --prepare",
    "model:train": "node scripts/train-model.cjs",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "esbuild": "0.25.9",
    "playwright": "1.55.0"
  }
}
